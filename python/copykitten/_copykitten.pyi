import os
import pathlib
from collections.abc import Callable
from uuid import UUID

class CopykittenError(Exception): ...
class ChangeEvent: ...

def copy(content: str) -> None: ...
def copy_wait(content: str) -> None: ...
def paste() -> str: ...
def clear() -> None: ...
def copy_image(content: bytes, width: int, height: int) -> None: ...
def copy_image_wait(content: bytes, width: int, height: int) -> None: ...
def paste_image() -> tuple[bytes, int, int]: ...
def copy_file_list(file_list: tuple[str | os.PathLike[str], ...]) -> None: ...
def copy_file_list_wait(*file_list: tuple[str | os.PathLike[str], ...]) -> None: ...
def paste_file_list() -> list[pathlib.Path]: ...
def listen(callback: Callable[[ChangeEvent], None]) -> UUID: ...
def unlisten(callback_id: UUID) -> bool: ...
